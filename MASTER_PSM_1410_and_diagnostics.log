. *******************************************************************************
> *
. * Common support and overlap.
. *******************************************************************************
> *
. quietly summarize _pscore if vd_backed==1 & psm_esample, meanonly

. scalar tmin=r(min)

. scalar tmax=r(max)

. quietly summarize _pscore if vd_backed==0 & psm_esample, meanonly

. scalar cmin=r(min)

. scalar cmax=r(max)

. scalar lower=max(tmin,cmin)

. scalar upper=min(tmax,cmax)

. gen byte overlap=inrange(_pscore,lower,upper) if psm_esample
(778 missing values generated)

. 
. tempname C

. postfile `C' str52 metric double value using "$ROOT/common_support.dta", replac
> e
(file C:/Users/user/Documents/VD/outputs/psm_rematch_rebuilt/common_support.dta
    not found)

. post `C' ("Treated propensity-score minimum") (tmin)

. post `C' ("Treated propensity-score maximum") (tmax)

. post `C' ("Control propensity-score minimum") (cmin)

. post `C' ("Control propensity-score maximum") (cmax)

. post `C' ("Common-support lower bound") (lower)

. post `C' ("Common-support upper bound") (upper)

. foreach g in 0 1 {
  2.     quietly count if vd_backed==`g' & psm_esample
  3.     post `C' ("Group `g': estimation N") (r(N))
  4.     quietly count if vd_backed==`g' & psm_esample & overlap==1
  5.     post `C' ("Group `g': in empirical overlap N") (r(N))
  6.     quietly count if vd_backed==`g' & psm_esample & overlap==0
  7.     post `C' ("Group `g': outside empirical overlap N") (r(N))
  8.     quietly count if vd_backed==`g' & psm_matched
  9.     post `C' ("Group `g': matched N") (r(N))
 10. }

. postclose `C'

