. tempname B

. postfile `B' str60 covariate str18 type double mean_t_before mean_c_before ///
>  smd_before vr_before mean_t_after mean_c_after smd_after vr_after ///
>  using "$ROOT/psm_balance.dta", replace
(file C:/Users/user/Documents/VD/outputs/psm_rematch_rebuilt/psm_balance.dta
    not found)

. 
. foreach v in founding_year funding_rounds_ref ln_funding_ref time_first_vc {
  2.     quietly summarize `v' if vd_backed==1 & psm_esample
  3.     local mt0=r(mean)
  4.     local vt0=r(Var)
  5.     quietly summarize `v' if vd_backed==0 & psm_esample
  6.     local mc0=r(mean)
  7.     local vc0=r(Var)
  8.     local pool=sqrt((`vt0'+`vc0')/2)
  9.     quietly summarize `v' if vd_backed==1 & psm_matched
 10.     local mt1=r(mean)
 11.     local vt1=r(Var)
 12.     quietly summarize `v' if vd_backed==0 & psm_matched
 13.     local mc1=r(mean)
 14.     local vc1=r(Var)
 15.     post `B' ("`v'") ("Continuous") (`mt0') (`mc0') ((`mt0'-`mc0')/`pool') (
> `vt0'/`vc0') ///
>         (`mt1') (`mc1') ((`mt1'-`mc1')/`pool') (`vt1'/`vc1')
 16. }

. 
. foreach stub in ind reg {
  2.     unab levels : `stub'_*
  3.     foreach v of local levels {
  4.         quietly summarize `v' if vd_backed==1 & psm_esample
  5.         local mt0=r(mean)
  6.         quietly summarize `v' if vd_backed==0 & psm_esample
  7.         local mc0=r(mean)
  8.         local pool=sqrt((`mt0'*(1-`mt0')+`mc0'*(1-`mc0'))/2)
  9.         quietly summarize `v' if vd_backed==1 & psm_matched
 10.         local mt1=r(mean)
 11.         quietly summarize `v' if vd_backed==0 & psm_matched
 12.         local mc1=r(mean)
 13.         local lab : variable label `v'
 14.         post `B' ("`lab'") ("Categorical level") (`mt0') (`mc0') ///
>             (cond(`pool'>0,(`mt0'-`mc0')/`pool',0)) (.) (`mt1') (`mc1') ///
>             (cond(`pool'>0,(`mt1'-`mc1')/`pool',0)) (.)
 15.     }
 16. }

. postclose `B'

