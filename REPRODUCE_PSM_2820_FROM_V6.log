. *******************************************************************************
> *
. * 5. TABLE A6: STANDARDIZED DIFFERENCES AND VARIANCE RATIOS
. * Balance is assessed with SMDs, not primarily with t-tests.
. * Variance ratios are reported for continuous covariates only.
. *******************************************************************************
> *
. gen byte psm_esample = !missing(_pscore)

. 
. tempname BAL

. postfile `BAL' str64 covariate str20 variable_type ///
>  double treated_before control_before smd_before variance_ratio_before ///
>  treated_after control_after smd_after variance_ratio_after ///
>  using "$DIAG/Table_A6_balance.dta", replace

. 
. local continuous ln_Total_Funding_Amount_FirstVD ///
>  NumberOfFunding_Rounds_FirstVD patent_application_VD Founding_Year TimeToFirst
> _VC

. foreach v of local continuous {
  2.     local lab "`v'"
  3.     if "`v'"=="ln_Total_Funding_Amount_FirstVD" local lab "Log total funding
>  amount at reference year"
  4.     if "`v'"=="NumberOfFunding_Rounds_FirstVD" local lab "Number of funding 
> rounds at reference year"
  5.     if "`v'"=="patent_application_VD" local lab "Patent applications through
>  reference year"
  6.     if "`v'"=="Founding_Year" local lab "Founding year"
  7.     if "`v'"=="TimeToFirst_VC" local lab "Time to first VC"
  8. 
.     quietly summarize `v' if VD_Backing==1 & psm_esample
  9.     local mt0=r(mean)
 10.     local vt0=r(Var)
 11.     quietly summarize `v' if VD_Backing==0 & psm_esample
 12.     local mc0=r(mean)
 13.     local vc0=r(Var)
 14.     local pool0=sqrt((`vt0'+`vc0')/2)
 15. 
.     quietly summarize `v' if VD_Backing==1 & matched_2820
 16.     local mt1=r(mean)
 17.     local vt1=r(Var)
 18.     quietly summarize `v' if VD_Backing==0 & matched_2820
 19.     local mc1=r(mean)
 20.     local vc1=r(Var)
 21.     local pool1=sqrt((`vt1'+`vc1')/2)
 22. 
.     post `BAL' ("`lab'") ("Continuous") ///
>       (`mt0') (`mc0') (cond(`pool0'>0,(`mt0'-`mc0')/`pool0',0)) (cond(`vc0'>0,`
> vt0'/`vc0',.)) ///
>         (`mt1') (`mc1') (cond(`pool1'>0,(`mt1'-`mc1')/`pool1',0)) (cond(`vc1'>0
> ,`vt1'/`vc1',.))
 23. }

. 
. * Region2 and Industry2 are reported as the original variables, one row each,
. * matching the historical Appendix table. Variance ratios are omitted because
. * their numeric codes represent categories rather than continuous quantities.
. foreach v in Region2 Industry2 {
  2.     if "`v'"=="Region2" local lab "Region2"
  3.     if "`v'"=="Industry2" local lab "Industry2"
  4.     quietly summarize `v' if VD_Backing==1 & psm_esample
  5.     local mt0=r(mean)
  6.     local vt0=r(Var)
  7.     quietly summarize `v' if VD_Backing==0 & psm_esample
  8.     local mc0=r(mean)
  9.     local vc0=r(Var)
 10.     local pool0=sqrt((`vt0'+`vc0')/2)
 11.     quietly summarize `v' if VD_Backing==1 & matched_2820
 12.     local mt1=r(mean)
 13.     local vt1=r(Var)
 14.     quietly summarize `v' if VD_Backing==0 & matched_2820
 15.     local mc1=r(mean)
 16.     local vc1=r(Var)
 17.     local pool1=sqrt((`vt1'+`vc1')/2)
 18.     post `BAL' ("`lab'") ("Categorical code") ///
>       (`mt0') (`mc0') (cond(`pool0'>0,(`mt0'-`mc0')/`pool0',0)) (.) ///
>       (`mt1') (`mc1') (cond(`pool1'>0,(`mt1'-`mc1')/`pool1',0)) (.)
 19. }

. postclose `BAL'

. 
. preserve

. use "$DIAG/Table_A6_balance.dta", clear

. gen abs_smd_before=abs(smd_before)

. gen abs_smd_after=abs(smd_after)

. gen byte exceeds_010_after=abs_smd_after>.10 if !missing(abs_smd_after)

. format treated_before control_before treated_after control_after %9.3f

. format smd_before smd_after variance_ratio_before variance_ratio_after %9.3f

. export delimited using "$DIAG/Table_A6_balance.csv", replace
file C:/Users/user/Documents/VD/outputs/psm_final_2820_package/replicated_appendi
> x/Table_A6_balance.csv saved

. 
. quietly summarize abs_smd_before, meanonly

. scalar max_smd_before=r(max)

. quietly summarize abs_smd_after, meanonly

. scalar max_smd_after=r(max)

. count if exceeds_010_after==1
  0

. scalar rows_over_010=r(N)

