. 
. foreach model in m1 m2 m3 m4 {
  2.     estadd local RegionFE "Yes" : `model'
  3.     estadd local IndustryFE "Yes" : `model'
  4.     estadd local FoundingYearControl "Yes" : `model'
  5. }

. 
. esttab m1 m2 m3 m4 using "$OUT/Table3_patent_application_win3.csv", ///
>     replace csv b(3) p(3) star(* 0.10 ** 0.05 *** 0.01) ///
>     noomitted nobaselevels drop(Foundingyear) ///
>     order(VD c.VD#c.patentdummybyfiling c.VD#c.earlystage ///
>           patentdummybyfiling earlystage ln_MoneyRaised_VD ///
>           NumofFundingRounds_VD _cons) ///
>     stats(RegionFE IndustryFE FoundingYearControl N r2, ///
>           labels("Region FE" "Industry FE" "Founding year control" ///
>                  "Observations" "R-squared") ///
>           fmt(%s %s %s 0 3))
