Number of observations (_N) was 0, now 8.

. keep if se > 0 & !missing(se)
(4 observations deleted)

. assert _N == 4

. gen byte stage = _n

. gen double lower = b-invttail(df,.025)*se

. gen double upper = b+invttail(df,.025)*se

. gen str8 pointlabel = string(b,"%5.3f")

. graph set window fontface "Times New Roman"

. graph set print fontface "Times New Roman"

