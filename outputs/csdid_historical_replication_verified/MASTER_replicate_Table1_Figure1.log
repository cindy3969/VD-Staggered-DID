. ********************************************************************************
. * FIGURE 1A: cohort-aligned raw means, weighted by treated cohort-cell N.
. ********************************************************************************
. tempfile cells

. tempname h

. postfile `h' int cohort byte event_time str8 group double mean_y long wt using `cells', replace
(file C:\Users\user\AppData\Local\Temp\ST_229c_000001.tmp not found)

. levelsof g_first_vd if g_first_vd>0, local(cohorts)
2011 2012 2013 2014 2015 2016 2017 2018 2019 2020 2021 2022 2023

. foreach g of local cohorts {
  2.     forvalues k=-4/4 {
  3.         local y=`g'+`k'
  4.         quietly count if g_first_vd==`g' & year==`y'
  5.         local n=r(N)
  6.         if `n'>0 {
  7.             quietly summarize apps_ult_granted if g_first_vd==`g' & year==`y', meanonly
  8.             local mt=r(mean)
  9.             quietly summarize apps_ult_granted if g_first_vd==0 & year==`y', meanonly
 10.             if r(N)>0 {
 11.                 post `h' (`g') (`k') ("Treated") (`mt') (`n')
 12.                 post `h' (`g') (`k') ("Control") (r(mean)) (`n')
 13.             }
 14.         }
 15.     }
 16. }

. postclose `h'

. use `cells', clear

. collapse (mean) mean_y [aw=wt], by(event_time group)

. sort group event_time

. export delimited using "$R/Figure1A_raw_means.csv", replace
file C:/Users/user/Documents/VD/outputs/csdid_historical_replication_verified/Figure1A_raw_means.csv saved

