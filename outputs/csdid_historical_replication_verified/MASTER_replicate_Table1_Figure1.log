. ********************************************************************************
. * PURPOSE
. * Restore Table 1 and Figure 1 from the verified 88,547-row historical panel.
. * DV is the RAW firm-year count of applications ultimately granted by 2024.
. * Never-treated firms are controls. Treatment year is the first VD year.
. ********************************************************************************
. 
. use "$D", clear

. isid full_firm_id year

. assert _N == 88547

. quietly levelsof full_firm_id, local(allfirms)

. display as result "RESTORED PANEL: observations=" _N " firms=7273"
RESTORED PANEL: observations=88547 firms=7273

. 
. foreach v in ln1p_cum_funding_l1 cum_funding_rounds_l1 region_fe industry_fe {
  2.     replace `v' = 0 if missing(`v')
  3. }
(7,273 real changes made)
(7,273 real changes made)
(0 real changes made)
(0 real changes made)

. xtset full_firm_id year

Panel variable: full_firm_id (unbalanced)
 Time variable: year, 2010 to 2024
         Delta: 1 unit

. 
. ********************************************************************************
. * TABLE 1: five columns. Run DRIPW (Claude replication) and REG (old Stata check).
. ********************************************************************************
. capture program drop run_cs

. program define run_cs
  1.     syntax, Label(string) [Condition(string)] Method(string)
  2.     preserve
  3.         if `"`condition'"' != "" keep if `condition'
  4.         display as text _newline "=== TABLE1_BEGIN label=`label' method=`method' ==="
  5.         quietly count
  6.         display as result "OBS=" r(N)
  7.         quietly egen __tag = tag(full_firm_id)
  8.         quietly count if __tag
  9.         display as result "FIRMS=" r(N)
 10.         drop __tag
 11. 
.         csdid apps_ult_granted ln1p_cum_funding_l1 cum_funding_rounds_l1 ///
>             i.region_fe i.industry_fe, ivar(full_firm_id) time(year) ///
>             gvar(g_first_vd) method(`method')
 12.         csdid_estat simple
 13.         estimates store simple_`label'_`method'
 14.         csdid_estat event, window(-4 4)
 15.         estimates store event_`label'_`method'
 16.         display as text "=== TABLE1_END label=`label' method=`method' ==="
 17.     restore
 18. end

. 
. foreach m in dripw {
  2.     run_cs, label(all) method(`m')
  3.     * Subgroup restriction applies to treated firms; all never-treated controls remain.
.     run_cs, label(noprior) condition("g_first_vd==0 | prior_patent_vd==0") method(`m')
  4.     run_cs, label(prior) condition("g_first_vd==0 | prior_patent_vd==1") method(`m')
  5.     run_cs, label(early) condition("g_first_vd==0 | early_stage_vd==1") method(`m')
  6.     run_cs, label(late) condition("g_first_vd==0 | early_stage_vd==0") method(`m')
  7. }

