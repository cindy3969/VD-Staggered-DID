. * ---- star helper ------------------------------------------------------------
. capture program drop _stars

. program define _stars, rclass
  1.     args b se
  2.     local p = 2*normal(-abs(`b'/`se'))
  3.     local s = cond(`p'<.01,"***",cond(`p'<.05,"**",cond(`p'<.1,"*","")))
  4.     return local coef = string(`b',"%9.3f") + "`s'"
  5.     return local se   = "(" + string(`se',"%9.3f") + ")"
  6. end

. 
. * ---- estimation loop --------------------------------------------------------
. forvalues j = 1/5 {
  2.     local c : word `j' of `col'
  3.     local h : word `j' of `hdr'
  4.     di as result _n "======== `h' ========"
  5. 
.     preserve
  6.     keep if `s`j''
  7. 
.     csdid ln_grantedapp_norm $X, ivar(full_firm_id) time(year) gvar(G) method(dripw)
  8. 
.     * observations / firms actually used by csdid
.     quietly count if e(sample)
  9.     local N = r(N)
 10.     egen byte __t = tag(full_firm_id) if e(sample)
 11.     quietly count if __t == 1
 12.     local F = r(N)
 13. 
.     * Simple ATT  (results are in r(), NOT e())
.     estat simple
 14.     matrix T = r(table)
 15.     _stars `=T[1,1]' `=T[2,1]'
 16.     local bS "`r(coef)'"
 17.     local sS "`r(se)'"
 18. 
.     * Aggregated event-study ATT = Post_avg
.     estat event, window(-4 4)
 19.     matrix T = r(table)
 20.     local k = colnumb(T, "Post_avg")
 21.     _stars `=T[1,`k']' `=T[2,`k']'
 22.     local bE "`r(coef)'"
 23.     local sE "`r(se)'"
 24. 
.     if `j' == 1 {
 25.         csdid_plot, yline(0) xline(0, lpattern(dash))              ///
>             xtitle("Years relative to first VD")                  ///
>             ytitle("ATT on ln(normalized granted applications)")  ///
>             graphregion(color(white)) name(fig1, replace)
 26.         graph export "$O/Figure1_ln_grantedapp_norm.png", replace width(2400)
 27.     }
 28. 
.     putexcel `c'3 = ("`h'")
 29.     putexcel `c'4 = ("`bS'") `c'5 = ("`sS'") `c'6 = ("`bE'") `c'7 = ("`sE'")
 30.     putexcel `c'8 = ("Yes") `c'9 = ("Yes") `c'10 = ("Yes")
 31.     putexcel `c'11 = (`N') `c'12 = (`F'), nformat("#,##0")
 32.     putexcel `c'13 = ("Never treat")
 33.     restore
 34. }

