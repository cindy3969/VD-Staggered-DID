. capture program drop capture_model

. program define capture_model
  1.     syntax, ID(integer)
  2.     tempname B V bb ss pp
  3.     matrix `B'=e(b)
  4.     matrix `V'=e(V)
  5.     local names : colfullnames `B'
  6.     local k=colsof(`B')
  7.     forvalues j=1/`k' {
  8.         local term : word `j' of `names'
  9.         scalar `bb'=`B'[1,`j']
 10.         scalar `ss'=sqrt(`V'[`j',`j'])
 11.         scalar `pp'=.
 12.         if `ss'>0 & !missing(`ss') {
 13.             if !missing(e(df_r)) scalar `pp'=2*ttail(e(df_r),abs(`bb'/`ss'))
 14.             else scalar `pp'=2*normal(-abs(`bb'/`ss'))
 15.         }
 16.         post capture_results (`id') ("`term'") (`bb') (`ss') (`pp') (e(N)) (
> e(r2)) (e(F)) (e(df_r)) (e(N_fail)) (e(cdf)) (e(widstat))
 17.     }
 18.     estimates save "C:/Users/user/Documents/VD/outputs/table_update_20261019
> /main_model_`id'.ster", replace
 19. end

