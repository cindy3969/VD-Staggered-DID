. local table=0

. foreach dose of local doses {
  2.     local ++table
  3.     if !inlist(`table',1,4) continue
  4.     preserve
  5.     egen byte tag0=tag(full_firm_id)
  6.     quietly count if tag0
  7.     local before=r(N)
  8.     generate byte complete=!missing(outcome,`dose',prior,late,post,prior_pat
> ent_l1,lag_late,ln1p_cum_funding_l1,ln1p_rounds_l1)
  9.     keep if complete
 10.     egen byte tag1=tag(full_firm_id)
 11.     quietly count if tag1
 12.     local complete_n=r(N)
 13.     * Audit pre/post coverage without excluding post-only firms.
.     bysort full_firm_id: egen byte minpost=min(post)
 14.     bysort full_firm_id: egen byte maxpost=max(post)
 15.     egen byte tag2=tag(full_firm_id)
 16.     quietly count if tag2 & minpost==0 & maxpost==1
 17.     local both=r(N)
 18.     post `sample' (`table') (`before') (`complete_n') (`both')
 19.     assert `complete_n'>1
 20.     generate double dose_post=`dose'*post
 21.     generate double dose_post_prior=dose_post*prior
 22.     generate double dose_post_late=dose_post*late
 23.     label variable dose_post "VD intensity x Post"
 24.     label variable dose_post_prior "VD intensity x Post x Prior patent"
 25.     label variable dose_post_late "VD intensity x Post x Late stage"
 26.     forvalues m=1/4 {
 27.         local rhs dose_post post `controls'
 28.         if inlist(`m',2,4) local rhs `rhs' dose_post_prior post_prior
 29.         if inlist(`m',3,4) local rhs `rhs' dose_post_late post_late
 30.         * Fixed dose and moderator main effects absorbed by firm FE.
.         * No dose x prior x late interaction is imposed by the reference tables
> .
.         xtreg outcome `rhs' i.year, fe vce(cluster full_firm_id)
 31.         estimates save "`out'/Table_3_`table'_model`m'.ster", replace
 32.         foreach term of local rhs {
 33.             scalar pv=.
 34.             if _se[`term']>0 scalar pv=2*ttail(e(df_r),abs(_b[`term']/_se[`t
> erm']))
 35.             post `coef' (`table') (`m') ("`term'") (_b[`term']) (_se[`term']
> ) (pv) (e(N)) (e(N_g)) (e(r2_w))
 36.         }
 37.     }
 38.     restore
 39. }
