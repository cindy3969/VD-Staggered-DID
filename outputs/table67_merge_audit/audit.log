. program define record_model
  1. syntax, Source(string) Model(string)
  2. tempname B V
  3. matrix `B'=e(b)
  4. matrix `V'=e(V)
  5. local names : colnames `B'
  6. forvalues j=1/`=colsof(`B')' {
  7. local term : word `j' of `names'
  8. local se=sqrt(`V'[`j',`j'])
  9. local prob=.
 10. if `se'>0 & !missing(`se') {
 11. if !missing(e(df_r)) local prob=2*ttail(e(df_r),abs(`B'[1,`j']/`se'))
 12. else local prob=2*normal(-abs(`B'[1,`j']/`se'))
 13. }
 14. post audit ("`source'") ("`model'") ("`term'") (`B'[1,`j']) (`se') (`prob') 
> (e(N)) (e(N_fail))
 15. }
 16. end

