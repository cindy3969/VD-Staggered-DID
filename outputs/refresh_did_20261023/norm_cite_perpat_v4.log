. foreach sample in all noprior prior nonlate late notyet {
  2.     local condition "1"
  3.     local opt ""
  4.     local ctrl "never"
  5.     if "`sample'"=="noprior" local condition "G==0 | prior==0"
  6.     if "`sample'"=="prior" local condition "G==0 | prior==1"
  7.     if "`sample'"=="nonlate" local condition "G==0 | late==0"
  8.     if "`sample'"=="late" local condition "G==0 | late==1"
  9.     if "`sample'"=="notyet" {
 10.         local opt "notyet"
 11.         local ctrl "notyet"
 12.     }
 13.     quietly count if `condition'
 14.     local N=r(N)
 15.     egen byte tag=tag(full_firm_id) if `condition'
 16.     quietly count if tag==1
 17.     local firms=r(N)
 18.     drop tag
 19.     display "BEGIN_SPEC v4 `sample' N=`N' firms=`firms'"
 20.     capture quietly csdid `dv' ln1p_cum_funding_l1 cum_funding_rounds_l1 i.region_fe i.industry_fe if `condition', ivar(full_firm_id) time(year) gvar(G) method(dripw) `opt'
 21.     local rc=_rc
 22.     if `rc' {
 23.         post `H' ("`sample'") ("`ctrl'") ("failed") ("csdid") (.) (.) (.) (`N') (`firms') (`rc')
 24.         continue
 25.     }
 26.     foreach agg in simple event group {
 27.         local window ""
 28.         if "`agg'"=="event" local window ", window(-4 4)"
 29.         capture noisily csdid_estat `agg' `window'
 30.         local rc=_rc
 31.         if `rc' {
 32.             post `H' ("`sample'") ("`ctrl'") ("`agg'") ("failed") (.) (.) (.) (`N') (`firms') (`rc')
 33.             continue
 34.         }
 35.         matrix T=r(table)
 36.         local names: colnames T
 37.         local j=0
 38.         foreach term of local names {
 39.             local ++j
 40.             post `H' ("`sample'") ("`ctrl'") ("`agg'") ("`term'") (T[1,`j']) (T[2,`j']) (T[4,`j']) (`N') (`firms') (0)
 41.         }
 42.     }
 43.     display "END_SPEC v4 `sample'"
 44. }
