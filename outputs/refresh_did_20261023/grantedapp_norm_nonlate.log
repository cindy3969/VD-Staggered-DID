. capture program drop construct_late

. program define construct_late
  1.     confirm variable full_firm_id year G stage_preyear_text
  2.     capture drop late
  3.     capture drop late_at_G
  4.     capture drop stage_at_G
  5.     gen str244 stage_at_G = lower(strtrim(stage_preyear_text)) if G>0 & year==G
  6.     gen byte late_at_G = .
  7.     replace late_at_G = 1 if G>0 & year==G & regexm(stage_at_G,"^series [c-z][0-9]*$")
  8.     replace late_at_G = 0 if G>0 & year==G & ///
>         (regexm(stage_at_G,"^series [ab][0-9]*$") | inlist(stage_at_G,"seed","pre-seed","angel"))
  9.     bysort full_firm_id: egen byte late = max(late_at_G)
 10.     label variable late "Series C+ through G-1 (1); Seed through B (0); unknown missing"
 11.     label define late_stage_label 0 "Seed through Series B" 1 "Series C+", replace
 12.     label values late late_stage_label
 13.     drop late_at_G stage_at_G
 14. end

. 
