. 
. capture program drop run_spec

. program define run_spec
  1.     syntax, Label(string) Keepif(string)
  2.     preserve
  3.     quietly keep if `keepif'
  4.     quietly count
  5.     display "=== BEGIN_SPEC `label' OBS_RAW=" r(N) " ==="
  6.     quietly egen __tag=tag(full_firm_id)
  7.     quietly count if __tag
  8.     display "FIRMS_RAW=" r(N)
  9.     drop __tag
 10.     csdid apps_ult_granted prior_patent_l1 ln1p_cum_funding_l1 cum_funding_rounds_l1 founding_year i.region_fe i.industry_fe, ///
>         ivar(full_firm_id) time(year) gvar(g_first_vd) method(dripw) long2
 11.     estat simple, estore(simple_`label')
 12.     estat event, window(-4 4) estore(event_`label')
 13.     display "=== END_SPEC `label' ==="
 14.     restore
 15. end

. 
. run_spec, label(all) keepif("1")
