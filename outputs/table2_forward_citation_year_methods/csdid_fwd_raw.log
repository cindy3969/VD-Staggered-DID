. program define run_fc_spec
  1.     syntax varname, Label(string) Keepif(string)
  2.     preserve
  3.     quietly keep if `keepif'
  4.     quietly count
  5.     display "=== BEGIN_SPEC outcome=`varlist' sample=`label' OBS_RAW=" r(N) 
> " ==="
  6.     quietly egen __tag=tag(full_firm_id)
