. tempname sm cr

. postfile `sm' str40 variable double N mean sd min max using "$OUT/summary.dta",
>  replace

. foreach v of local tablevars {
  2.  quietly summarize `v'
  3.  post `sm' ("`v'") (r(N)) (r(mean)) (r(sd)) (r(min)) (r(max))
  4. }

. postclose `sm'

. postfile `cr' str40 variable1 str40 variable2 double N r p using "$OUT/correlat
> ions.dta", replace

. foreach v of local tablevars {
  2.  foreach w of local tablevars {
  3.   quietly correlate `v' `w'
  4.   local n=r(N)
  5.   local rho=r(rho)
  6.   local p=.
  7.   if abs(`rho')<1 local p=2*ttail(`n'-2,abs(`rho')*sqrt((`n'-2)/(1-`rho'^2))
> )
  8.   post `cr' ("`v'") ("`w'") (`n') (`rho') (`p')
  9.  }
 10. }

. postclose `cr'

