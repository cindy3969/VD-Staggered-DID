. program define word_capture
  1.  global capture_id = $capture_id + 1
  2.  tempname B V bb ss pp
  3.  matrix `B'=e(b)
  4.  matrix `V'=e(V)
  5.  local names : colfullnames `B'
  6.  forvalues j=1/`=colsof(`B')' {
  7.   local term : word `j' of `names'
  8.   scalar `bb'=`B'[1,`j']
  9.   scalar `ss'=sqrt(`V'[`j',`j'])
 10.   scalar `pp'=.
 11.   if `ss'>0 & !missing(`ss') {
 12.    if !missing(e(df_r)) & e(cmd)!="ppmlhdfe" scalar `pp'=2*ttail(e(df_r),abs
> (`bb'/`ss'))
 13.    else scalar `pp'=2*normal(-abs(`bb'/`ss'))
 14.   }
 15.   post wordcapture ($capture_id) ("`term'") ("`e(cmd)'") (`bb') (`ss') (`pp'
> ) (e(N)) (e(r2)) (e(r2_p)) (e(F)) (e(df_r)) (e(N_fail)) (e(widstat))
 16.  }
 17.  display "CAPTURED_MODEL " $capture_id " `e(cmd)'"
 18. end

