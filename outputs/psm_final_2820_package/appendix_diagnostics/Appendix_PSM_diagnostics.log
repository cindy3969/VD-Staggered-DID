> *
. * 5. LEGACY TABLE A6 LAYOUT (MEANS, DIFFERENCES, AND T-TEST P-VALUES)
. * This reproduces the layout in the existing Appendix.  The strengthened
. * Table A6 above should remain the principal balance evidence.
. *******************************************************************************
> *
. use "$BASE/psm_full7316_with_scores.dta", clear

. gen double reference_year = cond(vd_backed==1,first_vd_year,founding_year+5)

. 
. tempname A6

. postfile `A6' str52 covariate ///
>  double treated_before control_before difference_before p_before ///
>  treated_after control_after difference_after p_after ///
>  using "$OUT/Table_A6_legacy_replication.dta", replace
(file
    C:/Users/user/Documents/VD/outputs/psm_final_2820_package/appendix_diagnost
    > ics/Table_A6_legacy_replication.dta not found)

. 
. local legacyvars founding_year reference_year time_first_vc funding_rounds_ref 
> ///
>     ln_funding_ref prior_patent region2 industry2

. foreach v of local legacyvars {
  2.     local vlabel "`v'"
  3.     if "`v'"=="founding_year"      local vlabel "Founding Year"
  4.     if "`v'"=="reference_year"     local vlabel "VD/Pseudo-VD Year"
  5.     if "`v'"=="time_first_vc"      local vlabel "Time To First VC"
  6.     if "`v'"=="funding_rounds_ref" local vlabel "Num Of Funding Rounds VD"
  7.     if "`v'"=="ln_funding_ref"     local vlabel "Log(Total Funding Amt VD)"
  8.     if "`v'"=="prior_patent"       local vlabel "Pre-VD Patent Indicator"
  9.     if "`v'"=="region2"            local vlabel "Startup Hub (legacy coded m
> ean)"
 10.     if "`v'"=="industry2"          local vlabel "Tech Intensive Industry (le
> gacy coded mean)"
 11. 
.     quietly summarize `v' if vd_backed==1 & psm_esample, meanonly
 12.     local tb=r(mean)
 13.     quietly summarize `v' if vd_backed==0 & psm_esample, meanonly
 14.     local cb=r(mean)
 15.     quietly ttest `v' if psm_esample, by(vd_backed)
 16.     local pb=r(p)
 17. 
.     quietly summarize `v' if vd_backed==1 & psm_matched, meanonly
 18.     local ta=r(mean)
 19.     quietly summarize `v' if vd_backed==0 & psm_matched, meanonly
 20.     local ca=r(mean)
 21.     quietly ttest `v' if psm_matched, by(vd_backed)
 22.     local pa=r(p)
 23. 
.     post `A6' ("`vlabel'") (`tb') (`cb') (`tb'-`cb') (`pb') ///
>         (`ta') (`ca') (`ta'-`ca') (`pa')
 24. }

. postclose `A6'

