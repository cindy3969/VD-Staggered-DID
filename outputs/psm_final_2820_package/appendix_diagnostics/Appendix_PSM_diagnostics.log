> ta", replace

. post `S' ("Treated propensity-score minimum") (tmin)

. post `S' ("Treated propensity-score maximum") (tmax)

. post `S' ("Control propensity-score minimum") (cmin)

. post `S' ("Control propensity-score maximum") (cmax)

. post `S' ("Empirical common-support lower bound") (lower)

. post `S' ("Empirical common-support upper bound") (upper)

. foreach g in 0 1 {
  2.     quietly count if vd_backed==`g' & psm_esample
  3.     post `S' ("Group `g': propensity-score estimation N") (r(N))
  4.     quietly count if vd_backed==`g' & psm_esample & empirical_overlap==1
  5.     post `S' ("Group `g': within empirical overlap N") (r(N))
  6.     quietly count if vd_backed==`g' & psm_esample & empirical_overlap==0
  7.     post `S' ("Group `g': outside empirical overlap N") (r(N))
  8.     quietly count if vd_backed==`g' & psm_matched
  9.     post `S' ("Group `g': final matched N") (r(N))
 10. }

. postclose `S'

