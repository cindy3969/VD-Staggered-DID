. tempname T

. postfile `T' str60 covariate str18 variable_type str3 matched_on ///
>  double treated_before control_before smd_before variance_ratio_before ///
>  treated_after control_after smd_after variance_ratio_after ///
>  using "$OUT/Table_A6_balance.dta", replace

. 
. local continuous founding_year reference_year time_first_vc funding_rounds_ref 
> ln_funding_ref

. foreach v of local continuous {
  2.     local vlabel "`v'"
  3.     if "`v'"=="founding_year"      local vlabel "Founding year"
  4.     if "`v'"=="reference_year"     local vlabel "Actual or pseudo reference 
> year"
  5.     if "`v'"=="time_first_vc"      local vlabel "Years from founding to firs
> t VC"
  6.     if "`v'"=="funding_rounds_ref" local vlabel "Number of funding rounds at
>  reference year"
  7.     if "`v'"=="ln_funding_ref"     local vlabel "Log cumulative funding at r
> eference year"
  8.     quietly summarize `v' if vd_backed==1 & psm_esample
  9.     local mt0=r(mean)
 10.     local vt0=r(Var)
 11.     quietly summarize `v' if vd_backed==0 & psm_esample
 12.     local mc0=r(mean)
 13.     local vc0=r(Var)
 14.     local pool=sqrt((`vt0'+`vc0')/2)
 15.     quietly summarize `v' if vd_backed==1 & psm_matched
 16.     local mt1=r(mean)
 17.     local vt1=r(Var)
 18.     quietly summarize `v' if vd_backed==0 & psm_matched
 19.     local mc1=r(mean)
 20.     local vc1=r(Var)
 21.     local used="Yes"
 22.     if "`v'"=="reference_year" local used="No"
 23.     post `T' ("`vlabel'") ("Continuous") ("`used'") ///
>         (`mt0') (`mc0') ((`mt0'-`mc0')/`pool') (`vt0'/`vc0') ///
>         (`mt1') (`mc1') ((`mt1'-`mc1')/`pool') (`vt1'/`vc1')
 24. }

. 
. * Prior patent is a substantively important diagnostic, but was not in the scor
> e.
. foreach v in prior_patent {
  2.     quietly summarize `v' if vd_backed==1 & psm_esample
  3.     local mt0=r(mean)
  4.     quietly summarize `v' if vd_backed==0 & psm_esample
  5.     local mc0=r(mean)
  6.     local pool=sqrt((`mt0'*(1-`mt0')+`mc0'*(1-`mc0'))/2)
  7.     quietly summarize `v' if vd_backed==1 & psm_matched
  8.     local mt1=r(mean)
  9.     quietly summarize `v' if vd_backed==0 & psm_matched
 10.     local mc1=r(mean)
 11.     post `T' ("`: variable label `v''") ("Binary") ("No") ///
>         (`mt0') (`mc0') ((`mt0'-`mc0')/`pool') (.) ///
>         (`mt1') (`mc1') ((`mt1'-`mc1')/`pool') (.)
 12. }

. 
. * Report categorical balance by level; do not compare arbitrary numeric codes.
. foreach stub in indcat regcat {
  2.     unab levels : `stub'_*
  3.     foreach v of local levels {
  4.         quietly summarize `v' if vd_backed==1 & psm_esample
  5.         local mt0=r(mean)
  6.         quietly summarize `v' if vd_backed==0 & psm_esample
  7.         local mc0=r(mean)
  8.         local pool=sqrt((`mt0'*(1-`mt0')+`mc0'*(1-`mc0'))/2)
  9.         quietly summarize `v' if vd_backed==1 & psm_matched
 10.         local mt1=r(mean)
 11.         quietly summarize `v' if vd_backed==0 & psm_matched
 12.         local mc1=r(mean)
 13.         local levelnum = subinstr("`v'","`stub'_","",1)
 14.         if "`stub'"=="indcat" local lab "Industry category `levelnum'"
 15.         if "`stub'"=="regcat" local lab "Region category `levelnum'"
 16.         post `T' ("`lab'") ("Categorical level") ("Yes") ///
>             (`mt0') (`mc0') (cond(`pool'>0,(`mt0'-`mc0')/`pool',0)) (.) ///
>             (`mt1') (`mc1') (cond(`pool'>0,(`mt1'-`mc1')/`pool',0)) (.)
 17.     }
 18. }

. postclose `T'

. 
. use "$OUT/Table_A6_balance.dta", clear

. replace covariate="Founding year" if covariate==""
(0 real changes made)

. replace covariate="Actual or pseudo reference year" if covariate=="reference_ye
> ar"
(0 real changes made)

