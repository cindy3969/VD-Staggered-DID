. ********************************************************************************
. * 5. TABLE A6: ORIGINAL APPENDIX LAYOUT
. ********************************************************************************
. gen double reference_year=cond(vd_backed==1,first_vd_year,founding_year+5)
(2 missing values generated)

. tempname A6

. postfile `A6' str52 covariate ///
>  double treated_before control_before difference_before p_before ///
>  treated_after control_after difference_after p_after ///
>  using "$OUT/Table_A6_legacy_exact_sample.dta", replace

. local a6vars founding_year reference_year time_first_vc funding_rounds_ref ///
>  ln_funding_ref pre_vd_patent_count region2 industry2

. foreach v of local a6vars {
  2.     local lab "`v'"
  3.     if "`v'"=="founding_year" local lab "Founding Year"
  4.     if "`v'"=="reference_year" local lab "VD/Pseudo-VD Year"
  5.     if "`v'"=="time_first_vc" local lab "Time To First VC"
  6.     if "`v'"=="funding_rounds_ref" local lab "Num Of Funding Rounds VD"
  7.     if "`v'"=="ln_funding_ref" local lab "Log(Total Funding Amt VD)"
  8.     if "`v'"=="pre_vd_patent_count" local lab "Pre-VD Granted Patent Applications"
  9.     if "`v'"=="region2" local lab "Startup Hub (coded mean)"
 10.     if "`v'"=="industry2" local lab "Tech Intensive Industry (coded mean)"
 11.     quietly summarize `v' if vd_backed==1 & psm_esample, meanonly
 12.     local tb=r(mean)
 13.     quietly summarize `v' if vd_backed==0 & psm_esample, meanonly
 14.     local cb=r(mean)
 15.     quietly ttest `v' if psm_esample, by(vd_backed)
 16.     local pb=r(p)
 17.     quietly summarize `v' if vd_backed==1 & psm_matched, meanonly
 18.     local ta=r(mean)
 19.     quietly summarize `v' if vd_backed==0 & psm_matched, meanonly
 20.     local ca=r(mean)
 21.     quietly ttest `v' if psm_matched, by(vd_backed)
 22.     local pa=r(p)
 23.     post `A6' ("`lab'") (`tb') (`cb') (`tb'-`cb') (`pb') ///
>         (`ta') (`ca') (`ta'-`ca') (`pa')
 24. }

. postclose `A6'

. use "$OUT/Table_A6_legacy_exact_sample.dta", clear

. format treated* control* difference* p_* %9.3f

. export delimited using "$OUT/Table_A6_legacy_exact_sample.csv", replace
