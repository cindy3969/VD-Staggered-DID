. xtset full_firm_id year

Panel variable: full_firm_id (unbalanced)
 Time variable: year, 2010 to 2021
         Delta: 1 unit

. capture program drop run_u

. program define run_u
  1.     syntax, Outcome(name) Label(string) [Condition(string)]
  2.     preserve
  3.         if `"`condition'"'!="" keep if `condition'
  4.         display as text _newline "=== UNION_BEGIN outcome=`outcome' sample=`label' ==="
  5.         quietly count
  6.         display as result "OBS=" r(N)
  7.         quietly egen __tag=tag(full_firm_id)
  8.         quietly count if __tag
  9.         display as result "FIRMS=" r(N)
 10.         drop __tag
 11.         csdid `outcome' ln1p_cum_funding_l1 cum_funding_rounds_l1 ///
>             i.region_fe i.industry_fe, ivar(full_firm_id) time(year) ///
>             gvar(G) method(dripw)
 12.         csdid_estat simple
 13.         csdid_estat event, window(-4 4)
 14.         display as text "=== UNION_END outcome=`outcome' sample=`label' ==="
 15.     restore
 16. end

. foreach y in granted_3yr_corrected granted_3yr_title_dedup {
  2.     run_u, outcome(`y') label(all)
  3.     run_u, outcome(`y') label(noprior) condition("G==0 | prior==0")
  4.     run_u, outcome(`y') label(prior) condition("G==0 | prior==1")
  5.     run_u, outcome(`y') label(early) condition("G==0 | early==1")
  6.     run_u, outcome(`y') label(late) condition("G==0 | early==0")
  7. }

