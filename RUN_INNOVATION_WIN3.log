. do C:\Users\user\Documents\VD\outputs\psm_final_2820_package\RUN_INNOVATION_WIN
> 3.do 

. * Called by RUN_TABLE3_PATENT_APPLICATION_WIN3.do; also runnable alone.
. * Preserves caller data. All outcomes use filing years t+1..t+3.
. * New-domain results are conditional on a complete, nonempty pre-t portfolio.
. * Primary CPC3 novelty != novel recombination. Partner distance != own distance
> .
. * Citation cutoff is 2024-12-31. No unavailable values are zero-filled here.
. version 19

. preserve

. global INROOT "C:/Users/user/Documents/VD/outputs/psm_final_2820_package"

. capture mkdir "$INROOT/table3_application_results"

. global INOUT "$INROOT/table3_application_results/innovation"

. capture mkdir "$INOUT"

. capture log close innovation

. log using "$INOUT/innovation_win3.log", text replace name(innovation)
---------------------------------------------------------------------------------
      name:  innovation
       log:  C:/Users/user/Documents/VD/outputs/psm_final_2820_package/table3_app
> lication_results/innovation/innovation_win3.log
  log type:  text
 opened on:  19 Oct 2026, 16:43:47

. use "$INROOT/table3_current_2820_cross_section_v2.dta", clear

. isid firm_id

. gen byte no_prior = 1-priorpatentdummy_VD

. gen byte early = earlystage

. local controls "i.no_prior i.early c.ln_MoneyRaised_VD c.NumofFundingRounds_VD"

. local fe "i.Region2 i.Industry2 i.Foundingyear"

. * New-domain baseline: all matched own patents granted before reference-year
. * Jan 1. newpat/oldpat partition primary CPC3 relative to that FIXED set.
. * No baseline -> missing, not new-domain=1. Counts include post-patent zeros;
. * shares and distances condition on at least one classified post patent.
. * own_dist = mean[1-cosine(one-hot primary CPC3, baseline class distribution)].
. * selfshare pools backward self-citations / all backward patent citations.
. * Explicit FE indicators implement the Table 3 FE structure with built-in
. * regress/fracreg/poisson; no singleton pruning or add-on installation needed.
. * No post-VD fundraising, employment or patent-count controls in primary fits.
. 
. * Existing Table A7 readability/figures/sheets/claims/grant-rate block is
. * intentionally untouched and NOT repeated by this module.
. local fractions "nocite_win3 breakthrough_win3 originality_win3 generality_win3
>  cite_diversity_win3 newshare_win3 own_dist_win3 selfshare_win3"

. local levels "partner_search_win3"

. local skew "desc_words_win3 cite_breadth_win3 selfcite_win3 partner_dist_win3"

. local counts "newpat_win3 oldpat_win3 newcpc_win3"

. local all "`fractions' `levels' `skew' `counts'"

. tempname res

. postfile `res' str32 dv str24 model double N N_VD N_control b se p lo hi ///
>     int rc using "$INOUT/innovation_models.dta", replace

. 
. foreach y of local all {
  2.     confirm numeric variable `y'
  3.     local transform : list y in skew
  4.     local iscount : list y in counts
  5.     local fraction : list y in fractions
  6.     capture drop outcome available
  7.     gen double outcome = `y'
  8.     if `transform' | `iscount' {
  9.         assert `y'>=0 if !missing(`y')
 10.         replace outcome = ln(1+`y')
 11.     }
 12.     if `fraction' assert inrange(`y',0,1) if !missing(`y')
 13.     gen byte available = win3_observed==1 & !missing(outcome,VD,no_prior,ear
> ly,ln_MoneyRaised_VD, ///
>         NumofFundingRounds_VD,Region2,Industry2,Foundingyear)
 14.     quietly count if available & VD==1
 15.     local nt=r(N)
 16.     quietly count if available & VD==0
 17.     local nc=r(N)
 18.     di as text "DV `y': treated=`nt', control=`nc'; ln1p=`transform' or `isc
> ount'"
 19.     * First four specifications parallel main Table 3. Fifth adds reference-
.     * year FE as a cohort/citation-exposure robustness check (not equal horizon
> s).
.     forvalues spec=1/5 {
 20.         local rhs "i.VD `controls' `fe'"
 21.         if `spec'==2 local rhs "i.VD##i.no_prior i.early c.ln_MoneyRaised_VD
>  c.NumofFundingRounds_VD `fe'"
 22.         if `spec'==3 local rhs "i.VD##i.early i.no_prior c.ln_MoneyRaised_VD
>  c.NumofFundingRounds_VD `fe'"
 23.         if `spec'==4 local rhs "i.VD##i.no_prior i.VD##i.early c.ln_MoneyRai
> sed_VD c.NumofFundingRounds_VD `fe'"
 24.         if `spec'==5 local rhs "i.VD `controls' `fe' i.VDyear"
 25.         capture noisily regress outcome `rhs' if available, vce(robust)
 26.         local err=_rc
 27.         if `err'==0 {
 28.             estimates save "$INOUT/`y'_ols`spec'.ster", replace
 29.             * For interacted models report average discrete VD change, not
.             * merely the VD coefficient for the omitted moderator category.
.             capture noisily margins, dydx(VD)
 30.             local err=_rc
 31.             if `err'==0 {
 32.                 matrix M=r(table)
 33.                 local j=colnumb("M","1.VD")
 34.                 if missing(`j') local err=498
 35.                 else if missing(M[1,`j'],M[2,`j'],M[4,`j']) local err=498
 36.                 if `err'==0 post `res' ("`y'") ("ols`spec'_VD_AME") (e(N)) (
> `nt') (`nc') ///
>                     (M[1,`j']) (M[2,`j']) (M[4,`j']) (M[5,`j']) (M[6,`j']) (0)
 37.             }
 38.             if `spec'==2 | `spec'==4 capture noisily test 1.VD#1.no_prior
 39.             if `spec'==3 | `spec'==4 capture noisily test 1.VD#1.early
 40.         }
 41.         if `err'!=0 post `res' ("`y'") ("ols`spec'_VD_AME") (.) (`nt') (`nc'
> ) (.) (.) (.) (.) (.) (`err')
 42.     }
 43.     * Functional-form checks: fractional logit keeps 0 and 1 observations;
.     * count PPML includes zero counts. Report AMEs on original outcome scale.
.     if `fraction' | `iscount' {
 44.         local family "fraclogit"
 45.         if `fraction' capture noisily fracreg logit `y' i.VD `controls' `fe'
>  if available, vce(robust) iterate(100)
 46.         if `iscount' {
 47.             local family "poisson"
 48.             capture noisily poisson `y' i.VD `controls' `fe' if available, v
> ce(robust) iterate(100)
 49.         }
 50.         local err=_rc
 51.         if `err'==0 {
 52.             if e(converged)!=1 local err=430
 53.         }
 54.         if `err'==0 {
 55.             estimates save "$INOUT/`y'_`family'.ster", replace
 56.             quietly count if e(sample) & VD==1
 57.             local nt2=r(N)
 58.             quietly count if e(sample) & VD==0
 59.             local nc2=r(N)
 60.             capture noisily margins, dydx(VD)
 61.             local err=_rc
 62.             if `err'==0 {
 63.                 matrix M=r(table)
 64.                 local j=colnumb("M","1.VD")
 65.                 if missing(`j') local err=498
 66.                 else if missing(M[1,`j'],M[2,`j'],M[4,`j']) local err=498
 67.                 if `err'==0 post `res' ("`y'") ("`family'_VD_AME") (e(N)) (`
> nt2') (`nc2') ///
>                     (M[1,`j']) (M[2,`j']) (M[4,`j']) (M[5,`j']) (M[6,`j']) (0)
 68.             }
 69.         }
 70.         if `err'!=0 post `res' ("`y'") ("`family'_VD_AME") (.) (`nt') (`nc')
>  (.) (.) (.) (.) (.) (`err')
 71.     }
 72. }
